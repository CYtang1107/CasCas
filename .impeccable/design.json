      "css": ".ds-driver-primary{font:600 .92rem/1.3 'Public Sans',system-ui,sans-serif;min-height:44px;padding:11px 16px;border:1px solid var(--control-line,#668091);border-radius:10px;cursor:pointer;transition:border-color .15s,background .15s,transform .1s;background:var(--accent,#54EAC3);color:var(--accent-ink,#0B2427)}.ds-driver-primary:hover{background:var(--accent-soft,#183D3B);border-color:var(--accent,#54EAC3)}.ds-driver-primary:focus-visible{outline:3px solid var(--accent-2, #81CFFF);outline-offset:4px}.ds-driver-primary:active{transform:scale(.98)}.ds-driver-primary{border-color:var(--accent,#54EAC3)}.ds-driver-primary:hover{background:var(--accent,#54EAC3);filter:brightness(1.07)}@media(prefers-reduced-motion:reduce){.ds-driver-primary{transition:none;transform:none}}"
