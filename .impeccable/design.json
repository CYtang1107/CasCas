  "narrative": {
    "northStar": "Night Drive / Operations Studio",
    "overview": "CasSama has two purposeful visual worlds. Night Drive is a calm midnight workspace for geographic decisions, with mint actions and selective high-opacity glass. Operations Studio is a warm-paper analytical workspace with white surfaces, ink structure and restrained neo-brutalist emphasis.\n\nThe shared type families and existing brand connect the worlds. Existing site illustrations support recognition rather than lead the decision. The implemented system is extracted from the final scoped stylesheet and current templates; it is not a seed or an Impeccable detector result.",
    "keyCharacteristics": [
      "Two role-specific palettes with shared typography.",
      "Geographic context for drivers; structured evidence for operators.",
      "Opaque critical content, visible focus and accessible disclosure."
    ],
    "rules": [
      {
        "name": "The Role Palette Rule",
        "body": "Keep Night Drive on driver surfaces and Operations Studio on management surfaces; the saved driver setting selects two night variants.",
        "section": "colors"
      },
      {
        "name": "The Evidence Rule",
        "body": "Make existing amounts, units, statuses and simulation qualifiers readable without changing their meaning or chart geometry.",
        "section": "typography"
      },
      {
        "name": "The Selective Glass Rule",
        "body": "Use high-opacity glass only for floating map search, detail and mobile recommendation surfaces; keep a solid fallback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the two role palettes and original theme handler.",
      "Do keep booking actions opaque and labels legible over bright map tiles.",
      "Do provide keyboard-operable size controls, visible focus and scrollable exact-value tables.",
      "Do retain source attribution, simulation qualifiers, errors and map fallbacks."
    ],
    "donts": [
      "Don't apply glass to dense management tables.",
      "Don't invent data, forecasts, destinations or nonfunctional controls.",
      "Don't use decorative kickers, glyph icons or new illustration systems as inherited house style.",
      "Don't change original business-handler bodies, fetching, storage or calculations to satisfy a visual goal."
    ]
  }
}
